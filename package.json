{
  "name": "agentwatch",
  "version": "0.5.1",
  "private": true,
  "description": "3D-офис для всех сессий Claude Code: «мой стол» для ответов агентам, смена режима, «Готово»",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "hook:install": "node bin/hook.js install",
    "hook:uninstall": "node bin/hook.js uninstall",
    "assets": "node bin/assets.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "three": "0.170.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jamshidmirzo/agentwatch.git"
  }
}
