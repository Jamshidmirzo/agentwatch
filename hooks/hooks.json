{
  "description": "AgentWatch: автозапуск офиса, ответы со «стола», смена режима из офиса",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/ensure.js\"", "timeout": 15 }] }
    ],
    "PermissionRequest": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/permission-hook.js\"", "timeout": 1800 }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/pretool.sh\"", "timeout": 5 }] }
    ]
  }
}
